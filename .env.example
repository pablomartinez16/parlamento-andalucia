# Entorno y Configuración
APP_ENV=production
DEBUG=False

# Base de datos PostgreSQL
POSTGRES_USER=parlamento_user
POSTGRES_PASSWORD=parlamento_pass_cambiar_en_produccion
POSTGRES_DB=parlamento_db

# URLs de conexión de SQLAlchemy
DATABASE_URL=postgresql+asyncpg://parlamento_user:parlamento_pass_cambiar_en_produccion@db:5432/parlamento_db
DATABASE_SYNC_URL=postgresql+psycopg2://parlamento_user:parlamento_pass_cambiar_en_produccion@db:5432/parlamento_db

# Scraping Ético
USER_AGENT=ParlamentoAbiertoAndalucia/1.0 (+https://github.com/parlamento-abierto; contacto@tu-dominio-o-email.es)
SCRAPE_RATE_LIMIT_SECONDS=1.0

# Sincronización periódica en segundo plano
ENABLE_SCHEDULER=True
SYNC_INTERVAL_MINUTES=30

# Módulo de Resúmenes LLM (opcional - desactivado por defecto)
ENABLE_LLM_SUMMARIES=False
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Cloudflare Tunnel (opcional si ejecutas cloudflared en Docker)
# Copia el token desde el panel de Cloudflare Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
