# /etc/nginx/sites-available/parlamento.local
# Copiar en tu VM de Nginx y hacer:
#   sudo ln -s /etc/nginx/sites-available/parlamento.local /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name parlamento.local;

    # Logs
    access_log /var/log/nginx/parlamento.access.log;
    error_log  /var/log/nginx/parlamento.error.log;

    # Proxy a Flask/Gunicorn en la VM
    location / {
        proxy_pass         http://IP-DE-LA-VM:5000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # Cabeceras de seguridad básicas
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
}
